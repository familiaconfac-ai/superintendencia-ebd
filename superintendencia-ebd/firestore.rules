rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() ? request.auth.token.get('email', '') : '';
    }

    function isAdministrativeRole(role) {
      return role in [
        'admin',
        'administrator',
        'superintendent',
        'superintendente',
        'superintendencia'
      ];
    }

    function hasAdministrativeProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isAdministrativeRole(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        );
    }

    function isEbdAdmin() {
      return isSignedIn() && (
        authEmail() == 'igrejabatistaolimpia@gmail.com'
        || hasAdministrativeProfile()
      );
    }

    function linkedTeacherId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('linkedTeacherId', '')
        : '';
    }

    function attendanceBelongsToCurrentTeacher(data) {
      return isSignedIn() && (
        data.get('ownerUid', '') == request.auth.uid
        || data.get('teacherUid', '') == request.auth.uid
        || data.get('teacherAuthUid', '') == request.auth.uid
        || data.get('teacherUserUid', '') == request.auth.uid
        || (
          linkedTeacherId() != ''
          && (
            data.get('teacherId', '') == linkedTeacherId()
            || data.get('defaultTeacherId', '') == linkedTeacherId()
          )
        )
        || data.get('teacherEmail', '') == authEmail()
        || data.get('defaultTeacherEmail', '') == authEmail()
      );
    }

    function teacherAttendanceFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'attendanceByStudent',
        'studentStatuses',
        'auditTrail',
        'updatedAt'
      ]);
    }

    function isEbdStructureCollection(collectionId) {
      return collectionId in [
        'ebd_people',
        'ebd_teachers',
        'ebd_classes',
        'ebd_enrollments',
        'ebd_materials'
      ];
    }

    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isEbdAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get('uid', uid) == uid
        && request.resource.data.get('role', 'teacher') == 'teacher'
        && !request.resource.data.keys().hasAny(['linkedTeacherId'])
      );

      allow update: if isEbdAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'preferredCurrency',
          'preferredExpenseCategoryId',
          'updatedAt'
        ])
      );

      allow delete: if isEbdAdmin();
    }

    match /{path=**}/ebd_attendanceRegisters/{registerId} {
      allow read: if isEbdAdmin() || attendanceBelongsToCurrentTeacher(resource.data);
      allow create, delete: if isEbdAdmin();
      allow update: if isEbdAdmin() || (
        attendanceBelongsToCurrentTeacher(resource.data)
        && attendanceBelongsToCurrentTeacher(request.resource.data)
        && teacherAttendanceFieldsOnly()
      );
    }

    match /users/{ownerUid}/{collectionId}/{document=**} {
      allow read: if isEbdStructureCollection(collectionId) && isSignedIn();
      allow create, update: if isEbdStructureCollection(collectionId) && isEbdAdmin();
      allow delete: if isEbdStructureCollection(collectionId)
        && collectionId != 'ebd_teachers'
        && isEbdAdmin();
    }

    match /users/{ownerUid}/ebd_lessonSessions/{sessionId} {
      allow read, write: if isEbdAdmin() || (
        isSignedIn() && request.auth.uid == ownerUid
      );
    }

    match /{path=**}/ebd_lessonSessions/{sessionId} {
      allow read: if isEbdAdmin();
    }

    // Mantem os dados pessoais e financeiros isolados pelo proprietario.
    match /users/{ownerUid}/{collectionId}/{document=**} {
      allow read, write: if isSignedIn()
        && request.auth.uid == ownerUid
        && !isEbdStructureCollection(collectionId)
        && collectionId != 'ebd_attendanceRegisters'
        && collectionId != 'ebd_lessonSessions';
      allow read, write: if isEbdAdmin()
        && collectionId != 'ebd_attendanceRegisters'
        && collectionId != 'ebd_teachers';
    }

    match /ebdSystemSettings/{documentId} {
      allow read: if isSignedIn();
      allow write: if isEbdAdmin();
    }

    match /ebdNoticeBroadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.get('authorUid', '') == request.auth.uid;
      allow update, delete: if isEbdAdmin();
    }

    match /ebdPushDevices/{uid} {
      allow read, write: if isEbdAdmin() || (
        isSignedIn() && request.auth.uid == uid
      );
    }

    // Recursos financeiros compartilhados continuam regidos pelos documentos
    // de membros do workspace, sem conceder acesso a cadernetas da EBD.
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.get('ownerUid', '') == request.auth.uid;
      allow update, delete: if isEbdAdmin() || (
        isSignedIn()
        && resource.data.get('ownerUid', '') == request.auth.uid
      );
    }

    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /workspaceInviteTokens/{documentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Colecoes legadas de presenca ficam restritas a administracao.
    match /cadernetas/{document=**} {
      allow read, write: if isEbdAdmin();
    }

    match /presencas/{document=**} {
      allow read, write: if isEbdAdmin();
    }
  }
}
